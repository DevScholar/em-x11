--- a/src/NextEvent.c	2024-11-17 12:44:07.000000000 +0800
+++ b/src/NextEvent.c	2026-04-25 15:26:05.637515200 +0800
@@ -368,11 +368,42 @@
 static int
 IoWait(wait_times_ptr_t wt, wait_fds_ptr_t wf)
 {
-#ifdef USE_POLL
-    return poll(wf->fdlist, (nfds_t) wf->fdlistlen, wt->poll_wait);
+#ifdef __EMSCRIPTEN__
+    /* em-x11 patch: our Display has no real fd, so libc select() returns
+     * immediately with 0 ready fds and the Xt wait loop spins with no
+     * yield -- freezing the browser. Use emscripten_sleep (requires
+     * ASYNCIFY) to yield time back to the event loop instead. After
+     * sleeping we return 0 (no fds ready); the outer _XtWaitForSomething
+     * re-checks XEventsQueued on the next iteration, by which time the
+     * JS side may have pushed new events via the emx11_push_* bridges. */
+    extern void emscripten_sleep(unsigned int ms);
+    int ms;
+# ifdef USE_POLL
+    ms = wt->poll_wait;
+    if (ms < 0) ms = 16;
+    if (ms > 16) ms = 16;
+# else
+    if (wt->wait_time_ptr == NULL) {
+        ms = 16;
+    } else {
+        long sec = (long)wt->wait_time_ptr->tv_sec;
+        long usec = (long)wt->wait_time_ptr->tv_usec;
+        long total = sec * 1000 + usec / 1000;
+        if (total <= 0) total = 1;
+        if (total > 16) total = 16;
+        ms = (int)total;
+    }
+# endif
+    (void)wf;
+    emscripten_sleep((unsigned int)ms);
+    return 0;
 #else
+# ifdef USE_POLL
+    return poll(wf->fdlist, (nfds_t) wf->fdlistlen, wt->poll_wait);
+# else
     return Select (wf->nfds, &wf->rmask, &wf->wmask, &wf->emask,
                    wt->wait_time_ptr);
+# endif
 #endif
 }
 
